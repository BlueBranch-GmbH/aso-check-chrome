{
  "manifest_version": 3,
  "name": "App Analyse – App Marketing Hub",
  "short_name": "App Analyse",
  "version": "1.0.0",
  "description": "Kostenlose ASO-Analyse für App Store & Google Play: Score für App-Name, Untertitel und Beschreibung mit einem Klick.",
  "homepage_url": "https://www.appmarketinghub.de/kostenloses-app-analyse-tool-von-app-marketing-hub",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "App analysieren",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://app-store-analyzer.appmarketinghub.de/*"]
}
