{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "ASO-Check",
  "version": "1.0.1",
  "description": "__MSG_extDescription__",
  "default_locale": "de",
  "homepage_url": "https://www.bluebranch.de/app-store-optimierung-aso",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ASO-Check starten",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://app-store-analyzer.appmarketinghub.de/*"]
}
